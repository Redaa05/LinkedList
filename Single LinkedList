#include<iostream>
using namespace std;

struct node 
{
  node* next;
    int value;
};

node* head = NULL;

void create()
{
    int choice;
    do
        {
            node* newnode = new node;
            cout<<"Enter values for nodes:";
            cin>>newnode->value;
            newnode -> next = NULL;

            if(head == NULL)
            {
                head = newnode;
            }
            else
            {
                node* temp = head;

            while(temp->next != NULL)
                {
                    temp = temp -> next;
                }
                temp -> next = newnode;
            }
            cout<<"Enter 0 to end, any other key to continue...: ";
            cin>>choice;
        }
        while(choice != 0);
}

void display(node* head)
{
    node* newnode = new node;
    node* temp = head;

    while(temp != NULL)
        {
            cout<<temp->value<<" ";
            temp = temp-> next;
        }
    cout<<endl;
}

void insertathead()
{
    node* newnode = new node;
    cout<<"Enter a value to insert at head: ";
    cin>>newnode->value;
    newnode->next = NULL;
    newnode->next = head;
    head = newnode;
}

void insertafterpos()
{
    node* newnode = new node;
    node* temp = head;
    int i=0; int pos;
     cout<<"Enter value to insert after position: ";
    cin>>newnode->value;
    cout<<"Enter position: ";
    cin>>pos;
   

    while(i<pos)
        {
            temp = temp->next;
            i++;
        }
    newnode -> next = temp -> next;
    temp -> next = newnode;
}

void insertbeforepos()
{
    node* newnode = new node;
    node* temp = head;
    int i=0; int pos;
     cout<<"Enter value to insert before position: ";
    cin>>newnode->value;
    cout<<"Enter position: ";
    cin>>pos;
   
    if(pos == 0)
    {
        newnode -> next = head;
        head = newnode;
        return;
    }

    while(i<pos-1)
        {
            temp = temp->next;
            i++;
        }
    newnode -> next = temp -> next;
    temp -> next = newnode;
}

void insertattail()
{
    node* temp = head;
    node* newnode=new node;
    cout<<"Enter the value to insert at tail: ";
    cin>>newnode->value;
    newnode -> next = NULL;
    while(temp->next != NULL)
        {
            temp = temp-> next;
        }
    temp -> next = newnode;
}

void deletehead()
    {

    if(head == NULL)
    {
        return;
    }
    node* temp = head;
    head = head -> next;
        cout<<"deleting head..: ";
    delete temp;
    }

void deletetail()
{
    node* temp = head;
    node* prev;

    while(temp -> next != NULL)
        {
            prev = temp;
            temp = temp -> next;
        }
    prev -> next = NULL;
    cout<<"deleting tail..: ";
    delete temp;
}

int length()
{
    int count=0;
    node* temp = head;
    while(temp != NULL)
        {
            count++;
            temp = temp -> next;
        }
    return count;
}

void deleteatpos()
{
    node* temp = head;
    node* prev = NULL;
    int pos;
    cout<<"Enter position to delete: ";
    cin>>pos;

    if(pos<1 || pos> length())

    {
        cout<<"Invalid position.";
        return;
    }

    if( pos == 1 )
    {
        head = head->next;
        cout<<"deleting...";
        delete temp;
        return;
    }

    for(int i=1; i<pos ; i++)
        {
            prev = temp;
            temp = temp ->next;
        }

        prev -> next = temp -> next;
    cout<<"deleting...";
        delete temp;
    
}


